# Curriculum reference files (PDFs/docs — tracked via public/curriculum/)
public/curriculum/

# Prevent accidental commits of personal/temp files
*.xlsx
*.db
*.resolved
*.sqlite

# One-time migration/seed scripts (keep .sql reference files only)
scripts/*.mjs
scripts/*.cjs
scripts/*.js
!scripts/*.sql

