dist/
dist-ssr/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.server
gcp-key.json

# Firebase cache
.firebase/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
ai-engine/venv/
ai-engine/__pycache__/
ai-engine/*.pyc
ai-engine/*.pyo
ai-engine/.env

# Misc build artifacts
*.local
dist-ssr/

# Temp/extracted folders
admin_updates_extracted/

# Kiro internal / repowiki (auto-generated)
.qoder/
.kiro/specs/

# Internal docs / deployment notes
PRODUCTION_DEPLOYMENT_GUIDE.md
REALTIME_LAUNCH_CHECKLIST.md
SYSTEM_DESIGN_AND_DEPLOYMENT.md
